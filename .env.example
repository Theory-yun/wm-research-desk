# 로컬에서 수동으로 build 스크립트를 테스트할 때 사용하는 예시 파일입니다.
# 실제 운영(GitHub Actions)에서는 이 파일을 쓰지 않고,
# Repo → Settings → Secrets and variables → Actions → New repository secret 에
# 아래 키 이름 그대로 등록하세요. (.env 파일은 절대 레포에 커밋하지 마세요)

# 둘 중 하나만 있어도 AI 요약이 동작합니다. 둘 다 없으면 규칙 기반 폴백 요약으로 자동 대체됩니다.
# 둘 다 넣어두면 Gemini를 먼저 시도하고, 실패할 때만 Claude로 자동 전환됩니다(이중 안전망).

# 1순위: 일자별 핵심 요약(issues/talkingPoint)을 생성하는 Gemini API 키 (aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 선택: 맨 먼저 시도할 Gemini 모델 ID. 비워두면 scripts/lib/summarize.mjs의 후보 목록
# (gemini-3.5-flash → gemini-3.5-flash-lite → gemini-flash-lite-latest → gemini-3.1-flash-lite)을
# 순서대로 시도합니다. 한 모델이 503(수요 폭주)·단종·타임아웃이면 자동으로 다음 모델로 넘어갑니다.
GEMINI_MODEL=

# 2순위(선택): Gemini 키가 없거나 호출이 실패할 때 대신 쓰이는 Claude API 키
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 선택: 사용할 Claude 모델 ID. 비워두면 scripts/lib/summarize.mjs의 기본값을 사용합니다.
# 아래 값은 작성 시점 예시이며, 실제 사용 전 Anthropic 콘솔(console.anthropic.com)에서
# 현재 사용 가능한 모델 ID를 반드시 확인해 Repository variable(ANTHROPIC_MODEL)로 지정하세요.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
